{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "somewhat-magical-jev-ball",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    // Only /api/* runs the Worker; everything else is served as a static file.
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "somewhatmagicaljevball.com", "custom_domain": true },
    { "pattern": "somewhatmagicaljevball.raunaqgupta.com", "custom_domain": true }
  ],
  // Jev is a model in Workers AI's own catalog ("typesafe/jev"), called through this binding
  // (see lib/decide.js's askJev) rather than TypeSafe's API directly. Cloudflare's own
  // AI Gateway BYOK doesn't cover TypeSafe: it only proxies a fixed list of providers that
  // doesn't include it (confirmed against api.cloudflare.com's docs, see issue #37).
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "FEED", "class_name": "Feed" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Feed"] }],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "4021",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      // WebSocket connections to the live feed, per IP.
      "name": "FEED_LIMITER",
      "namespace_id": "4022",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  // What `wrangler preview` (Cloudflare's build for a branch other than the production one)
  // deploys. A preview does not inherit the settings above, so it repeats the bindings the
  // Worker reads. Each preview gets its own Durable Object namespace and storage; the rate
  // limiters use namespace ids of their own so a preview does not share production's counts.
  "previews": {
    "ai": { "binding": "AI" },
    "durable_objects": {
      "bindings": [{ "name": "FEED", "class_name": "Feed" }]
    },
    "ratelimits": [
      {
        "name": "RATE_LIMITER",
        "namespace_id": "4023",
        "simple": { "limit": 20, "period": 60 }
      },
      {
        "name": "FEED_LIMITER",
        "namespace_id": "4024",
        "simple": { "limit": 20, "period": 60 }
      }
    ]
  }
}
