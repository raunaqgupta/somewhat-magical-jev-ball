{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "somewhat-magical-jev-ball",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    // Only /api/* runs the Worker; everything else is served as a static file.
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "somewhatmagicaljevball.com", "custom_domain": true },
    { "pattern": "somewhatmagicaljevball.raunaqgupta.com", "custom_domain": true }
  ],
  // "AI_GATEWAY_BASE_URL" is unset for now: the gateway rejected "typesafe" as the provider
  // segment ("400 Invalid provider"), so jevConfig (lib/decide.js) falls back to calling
  // TypeSafe directly until the correct provider slug is confirmed. See issue #37.
  //
  // "vars": {
  //   "AI_GATEWAY_BASE_URL": "https://gateway.ai.cloudflare.com/v1/0d6eb73be1743ce8fb62139cb54203a4/somewhat-magical-jev-ball/typesafe"
  // },
  "durable_objects": {
    "bindings": [{ "name": "FEED", "class_name": "Feed" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Feed"] }],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "4021",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      // WebSocket connections to the live feed, per IP.
      "name": "FEED_LIMITER",
      "namespace_id": "4022",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
}
