{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "somewhat-magical-jev-ball",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    // Only /api/* runs the Worker; everything else is served as a static file.
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "somewhatmagicaljevball.com", "custom_domain": true },
    { "pattern": "somewhatmagicaljevball.raunaqgupta.com", "custom_domain": true }
  ],
  "vars": {
    // Not secret: an account ID and a gateway/provider slug, the same as appear in the
    // Cloudflare dashboard's URL. The gateway holds the real TypeSafe key as a Bring Your Own
    // Key; reaching it also needs the CF_AI_GATEWAY_TOKEN secret (see README).
    "AI_GATEWAY_BASE_URL": "https://gateway.ai.cloudflare.com/v1/0d6eb73be1743ce8fb62139cb54203a4/somewhat-magical-jev-ball/typesafe"
  },
  "durable_objects": {
    "bindings": [{ "name": "FEED", "class_name": "Feed" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Feed"] }],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "4021",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      // WebSocket connections to the live feed, per IP.
      "name": "FEED_LIMITER",
      "namespace_id": "4022",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
}
