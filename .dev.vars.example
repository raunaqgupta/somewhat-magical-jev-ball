# Local secrets for `npm start` (wrangler dev). Copy to .dev.vars and fill in.

# Only needed until CF_AI_GATEWAY_TOKEN is set: TypeSafe's own key, for calling it directly.
TYPESAFE_API_KEY=

# The AI Gateway's own auth (cf-aig-authorization), separate from the TypeSafe key it holds as
# a Bring Your Own Key. Once this is set, calls go through the gateway instead.
CF_AI_GATEWAY_TOKEN=
